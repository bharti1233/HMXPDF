<?xml version="1.0" encoding="utf-8"?>
<!--
  Staging-only build type manifest. INTERNET is added here, not to the main
  manifest, so production variants keep their existing permission set.
  Used only by the opt-in explicit diagnostics report and remote config fetch.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
</manifest>
